# Copy to .env. Generate both secrets; never commit .env.
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OL_API_TOKEN=
POSTGRES_PASSWORD=
# Use /v1 on llama.cpp or Ollama, not /api.
OL_AI_BASE_URL=http://host.containers.internal:8080/v1
OL_AI_MODEL=local-model
OL_AI_API_KEY=local
# Reserved for later semantic search; lexical search works without embeddings.
OL_EMBEDDING_MODEL=
# Keep loopback default. For Android over LAN/Tailscale, explicitly bind the
# host's private interface and firewall the port; prefer a TLS reverse proxy.
OL_BIND_ADDRESS=127.0.0.1
