<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ ignores allowBackup for device-to-device transfer, so exclude private data explicitly.
     The Room file holds note text, cached cards and queued imports; shared preferences hold the encrypted token. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
