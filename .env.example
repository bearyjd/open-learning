# Copy to .env. Generate both secrets; never commit .env.
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OL_API_TOKEN=
POSTGRES_PASSWORD=
# Use /v1 on llama.cpp or Ollama, not /api.
OL_AI_BASE_URL=http://host.containers.internal:8080/v1
OL_AI_MODEL=local-model
OL_AI_API_KEY=local
# Optional backend-only cloud profile. Keep these unset for local inference.
# Create a dedicated OpenRouter inference key with a nonresetting spending limit
# in the OpenRouter dashboard. Never use a management or provisioning key.
# OL_AI_BACKEND=openrouter
# OL_CLOUD_OPT_IN=true
# OL_OPENROUTER_API_KEY=<dedicated-inference-key>
# OL_OPENROUTER_MODEL=<exact-author/model-id>
# OL_OPENROUTER_PROVIDER=<exact-endpoint-tag-from-model-endpoints>
# OL_OPENROUTER_REQUEST_BUDGET_USD=<positive-decimal-usd>
# OL_OPENROUTER_LIFETIME_BUDGET_USD=<positive-decimal-usd>
# OL_OPENROUTER_KEY_LIMIT_USD=<dashboard-key-limit-usd>
# OL_OPENROUTER_REQUEST_FEE_CAP_USD=<nonnegative-decimal-usd>
# OL_OPENROUTER_OUTPUT_TOKENS=3000
# Reserved for later semantic search; lexical search works without embeddings.
OL_EMBEDDING_MODEL=
# Keep loopback default. For Android over LAN/Tailscale, explicitly bind the
# host's private interface and firewall the port; prefer a TLS reverse proxy.
OL_BIND_ADDRESS=127.0.0.1
